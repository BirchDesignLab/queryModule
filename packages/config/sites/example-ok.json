{
  "schemaVersion": 1,
  "extends": "default",
  "site": { "id": "example-ok", "labelKey": "site.exampleOk" },
  "defaults": { "state": "OK" },
  "terminal": { "delimiter": "/" },
  "shortcuts": { "focusTerminal": { "keys": "Ctrl+Slash", "context": "global" } },
  "picklists": [{ "id": "propertyType", "values": [{ "code": "BOAT", "$remove": true }] }],
  "queryTypes": [
    {
      "code": "VEH",
      "fields": [
        {
          "key": "tagSticker",
          "labelKey": "field.tagSticker",
          "dataType": "string",
          "section": "expanded",
          "custom": true
        }
      ],
      "rules": [
        {
          "field": "plateType",
          "when": { "field": "state", "op": "neq", "value": { "$default": "state" } },
          "effect": "show"
        },
        {
          "field": "plateType",
          "when": { "field": "state", "op": "neq", "value": { "$default": "state" } },
          "effect": "require"
        },
        {
          "field": "plateColor",
          "when": { "field": "state", "op": "neq", "value": { "$default": "state" } },
          "effect": "show"
        },
        {
          "field": "plateColor",
          "when": { "field": "state", "op": "neq", "value": { "$default": "state" } },
          "effect": "require"
        }
      ]
    }
  ],
  "commands": [
    { "code": "NAM", "queryType": "PER", "positions": ["last", "first", "race", "sex", "dob"] }
  ]
}
