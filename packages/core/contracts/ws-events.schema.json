{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query Module WebSocket protocol v1",
  "$defs": {
    "WsClientMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "hello"
            },
            "lastSeq": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "v",
            "type",
            "lastSeq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "ping"
            },
            "nonce": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "v",
            "type",
            "nonce"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "ackReceipt"
            },
            "correlationId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "receivedAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "v",
            "type",
            "correlationId",
            "receivedAt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "WsServerMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "welcome"
            },
            "latestSeq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "v",
            "type",
            "latestSeq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "pong"
            },
            "nonce": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "serverTime": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "v",
            "type",
            "nonce",
            "serverTime"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "sourceStatus"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "correlationId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "partId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "sourceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "resultId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "returned",
                "failed",
                "timedOut",
                "interrupted",
                "credentialsMissing",
                "credentialsRejected"
              ]
            }
          },
          "required": [
            "v",
            "type",
            "seq",
            "at",
            "correlationId",
            "partId",
            "sourceId",
            "resultId",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "resultHidden"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "correlationId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "resultIds": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          },
          "required": [
            "v",
            "type",
            "seq",
            "at",
            "correlationId",
            "resultIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "type": {
              "type": "string",
              "const": "resync"
            },
            "reason": {
              "type": "string",
              "enum": [
                "tooOld",
                "tooMany",
                "unknownCursor"
              ]
            },
            "latestSeq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "v",
            "type",
            "reason",
            "latestSeq"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
