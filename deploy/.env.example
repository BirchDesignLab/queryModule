# Non-secret deploy config (spec 8.2). Copy to deploy/.env on the host; .env is never committed.
PUBLIC_ORIGIN=https://querymodule.birchdesignlab.com
# SITE_CONFIG unset on the demo host: the image runs its bundled packages/config (spec 8.1)
ADAPTER_DIR=/adapters
# true only on the demo host, CI and dev (spec 5.4)
ALLOW_MOCK_SOURCES=true
IDENTITY_MODES=standalone
MIN_CLIENT_VERSION=
# Comma-separated origins (https://host, no path or trailing slash); empty means PUBLIC_ORIGIN only.
# A request with any other Origin gets 403; a malformed entry stops the app at boot.
CORS_ORIGINS=
FRAME_ANCESTORS=
# WebSocket upgrades per client IP per window; empty keeps the defaults 60 and 60000 ms (D-A9)
WS_UPGRADE_LIMIT=
WS_UPGRADE_WINDOW_MS=
