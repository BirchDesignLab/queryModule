# Non-secret deploy config (spec 8.2). Copy to deploy/.env on the host; .env is never committed.
PUBLIC_ORIGIN=https://querymodule.birchdesignlab.com
# SITE_CONFIG unset on the demo host: the image runs its bundled packages/config (spec 8.1)
ADAPTER_DIR=/adapters
# true only on the demo host, CI and dev (spec 5.4)
ALLOW_MOCK_SOURCES=true
IDENTITY_MODES=standalone
MIN_CLIENT_VERSION=
CORS_ORIGINS=
FRAME_ANCESTORS=
