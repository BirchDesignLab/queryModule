# Tiered globs for the CLAUDE.md sensitive areas (spec 9.1, ADR-0007). One glob per line.
# [critical]: a review artifact from Opus 5.5 at effort high or above (#92).
# [gate]:     a review artifact from Opus 5.5 at effort medium or above (#92).
#             The artifact is docs/reviews/<branch>.md ("/" to "-") or docs/reviews/pr-<n>.md;
#             mode "fast" covers at most 50 changed lines in critical and gate files.
# [deps]:     no artifact; the ci job's licence check, pnpm audit, dependency review and
#             workflow lint cover it.
# [exempt]:   never needs a review (lowers [gate] and [deps], never [critical]).
# A file takes the highest tier from the base and the head copy of this file, so a PR
# cannot lower the tier that judges it. A version-only change of an existing action or
# package counts as [deps]: in package.json, the same package names with plain semver
# versions; in a workflow, only the ref after "@" of existing `uses:` lines.

[critical]
# Credential handling
packages/api/src/credentials/**
packages/api/src/secrets.ts
packages/api/src/keys/**
packages/api/src/db/**
# Audit logging
packages/api/src/audit/**
packages/api/src/seams.ts
packages/api/src/startup.ts
packages/api/src/main.ts
packages/core/src/contracts/audit.ts
packages/core/src/contracts/audit-auth.ts
packages/core/src/contracts/primitives.ts
packages/core/src/contracts/identity.ts
# Query dispatch, source adapters, nested-query planner
packages/api/src/dispatch/**
packages/api/src/adapters/**
packages/core/src/contracts/source-status.ts
packages/core/src/contracts/ws.ts
packages/core/src/contracts/version.ts
packages/core/contracts/ws-events.schema.json
packages/core/src/planner/**
# Query routes and the access policy (spec 5.2, SEC-014)
packages/api/src/queries/**
# Admin console (ADR-0011 Consequences): config swaps live config and writes audit;
# the shared top-level admin files (router, policy)
packages/api/src/admin/config/**
packages/api/src/admin/*.ts
# Delegation
packages/api/src/delegation/**
# Terminal command parser
packages/core/src/terminal/**
# Write-back
packages/api/src/writeback/**
# Delete-from-view and result hiding
packages/api/src/results/**
# Migrations (they create the tables of every area above)
packages/api/drizzle/**
# The sensitive-review gate itself
.github/sensitive-paths
scripts/ci/sensitive-review.ts
scripts/ci/check-sensitive-review.ts
# Reserved: the audit_event immutability guard (spec 9.2, SEC-010 to SEC-013)
scripts/ci/check-audit-migrations.ts
# Its source layer: no writable_schema or schema-table write in app code (#189, A2 C-M3)
scripts/ci/check-schema-writes.ts
# The entry-point guard both checks above start main through; a fail-open there skips them (#311 C-m1)
scripts/ci/is-main-module.mjs
# Reserved: TokenStore implementations, bearer token storage (SEC-006, #85); name
# the file or directory *token-store* (for example the P1 native SecureStore store).
# The bracket forms match any case and separator (TokenStore, tokenStore,
# token_store), file or directory (#96 C-M1; picomatch has no per-glob nocase).
**/*token-store*
**/*token-store*/**
**/*[Tt][Oo][Kk][Ee][Nn]*[Ss][Tt][Oo][Rr][Ee]*
**/*[Tt][Oo][Kk][Ee][Nn]*[Ss][Tt][Oo][Rr][Ee]*/**

[gate]
# Verify gate and merge path
.github/**
scripts/ci/**
scripts/ops/**
**/biome.json
.gitignore
**/vitest.config.ts
**/vite.config.ts
package.json
pnpm-workspace.yaml
tsconfig.base.json
**/tsconfig.json
# Log redaction, spec 5.9 (developer decision 09-27-26: gate)
packages/api/src/log/**
# Auth and sessions (developer decision 09-27-26: gate, not critical)
packages/api/src/auth/**
packages/api/src/http/session.ts
packages/api/src/ws/**
packages/api/src/seed/**
packages/api/src/ops/**
packages/api/src/deps.ts
packages/api/src/events/**
# Admin console floor (ADR-0011 Consequences): admin/users is auth; anything new under
# admin/ is at least gate
packages/api/src/admin/**
# Request guards (#338, checker 09-29-26)
# X-Requested-With CSRF guard, security headers, body cap
packages/api/src/http/security.ts
# sets the CSP nonce header on served pages
packages/api/src/http/web.ts
# the one place the CSRF, header and body-cap middleware is mounted
packages/api/src/app.ts

[deps]
# .github/dependabot.yml stays [gate] (.github/**): no automated check reads it.
pnpm-lock.yaml

[exempt]
.github/ISSUE_TEMPLATE/**
.github/pull_request_template.md
